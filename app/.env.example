# Voorbeeld van app/.env — kopieer dit bestand naar `.env` en vul de
# echte waarden in. Het echte .env-bestand gaat nooit mee naar GitHub.
#
# Waar je ze vindt:
#   VITE_SUPABASE_URL      Supabase → Project Settings → API → Project URL
#   VITE_SUPABASE_ANON_KEY Supabase → Project Settings → API → anon public
#
# De anon key is bedoeld om in de browser te staan; die is afgeschermd door
# de beveiligingsregels in de database.
#
# Voor het publiceren staan dezelfde twee waarden in GitHub onder
# Settings → Secrets and variables → Actions.

VITE_SUPABASE_URL=https://jouw-project.supabase.co
VITE_SUPABASE_ANON_KEY=vul-hier-de-anon-key-in
